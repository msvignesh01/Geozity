{
  "name": "geozity-globe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "pnpm setup:local && vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "setup:local": "node --env-file-if-exists=.env.local scripts/configure-local.mjs",
    "test:voice:live": "node scripts/check-voice.mjs",
    "test:ai:live": "node scripts/check-ai.mjs",
    "format:check": "prettier --check src tests scripts worker.ts *.config.ts package.json tsconfig.json",
    "deploy:api": "wrangler deploy --config wrangler.toml"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "hono": "^4.13.7",
    "maplibre-gl": "^6.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sarvamai": "^1.1.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.79.0"
  }
}
